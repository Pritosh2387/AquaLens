# ─────────────────────────────────────────────────────────────────────────────
# AquaLens — Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Python virtual environments
.venv/
venv/
env/
ENV/
.env/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
*.whl

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.coverage.*
coverage.xml
.hypothesis/

# Type checking
.mypy_cache/
.pytype/
pyrightconfig.json

# ── Environment variables (NEVER commit real .env files) ─────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
*.local

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
dist-ssr/
.svelte-kit/
build/

# Package manager locks (keep package-lock.json)
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.js

# Vite / build caches
.vite/
frontend/.vite/

# ── Data & Outputs (generated — too large for git) ──────────────────────────
# Keep directory structure via .gitkeep, ignore all generated content
backend/data/mock/*
!backend/data/mock/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
.cache/

data/
outputs/
