# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Distribution
*.egg-info/
dist/
build/
*.whl

# Environment variables
.env
.env.local
.env.*

# Outputs (generated — not committed)
outputs/
# Preserve directory structure:
!outputs/.gitkeep

# Generated mock data (re-generate with scripts/generate_mock_data.py)
data/mock/*
!data/mock/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
